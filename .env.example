# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/campusconnect

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@campusconnect.app

# ── Stripe ────────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Dashboard → Products → Premium ($14.99/mo) → Price ID
STRIPE_PRICE_ID=price_xxxxxxxxxxxx
# Dashboard → Products → Cross-Campus Premium ($29.99/mo) → Price ID
STRIPE_CROSS_CAMPUS_PRICE_ID=price_xxxxxxxxxxxx

# ── RevenueCat (mobile IAP) ───────────────────────────────────────────────────
# Dashboard → Project Settings → Webhooks → add endpoint → copy the secret
REVENUECAT_WEBHOOK_SECRET=rc_whsec_xxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────────
# Production: https://campusconnect.app  (no trailing slash)
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
